---
// Root: send visitors to their language. Static, so it works on any host.
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ASPIRE Stargate</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://www.aspire.id/id/" />
    <link rel="alternate" hreflang="id-ID" href="https://www.aspire.id/id/" />
    <link rel="alternate" hreflang="en" href="https://www.aspire.id/en/" />
    <link rel="alternate" hreflang="x-default" href="https://www.aspire.id/id/" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <meta http-equiv="refresh" content="0; url=/id/" />
    <script is:inline>
      try {
        var l = (navigator.language || '').toLowerCase();
        if (l && !l.startsWith('id') && !l.startsWith('ms')) location.replace('/en/');
        else location.replace('/id/');
      } catch (e) {}
    </script>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #9c3b1e; color: #fff4ec; font: 600 1rem/1.5 system-ui, sans-serif; }
      a { color: inherit; margin: 0 0.75rem; }
    </style>
  </head>
  <body>
    <p><a href="/id/">Bahasa Indonesia</a> · <a href="/en/">English</a></p>
  </body>
</html>
