---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';
---
<Base lang="id" title="Halaman tidak ditemukan · Page not found" description="Halaman yang Anda cari tidak ditemukan. The page you were looking for was not found." noindex>
  <section class="lost ground-laterite">
    <div class="wrap lost__grid">
      <p class="stamp lost__depth" aria-hidden="true">404 m</p>
      <div>
        <h1 class="display">Bench ini belum dibuka.</h1>
        <p class="lead">Halaman yang Anda cari tidak ada atau telah dipindahkan.</p>
        <p class="lead" lang="en">This bench hasn’t been opened. The page you were looking for doesn’t exist or has moved.</p>
        <div class="actions">
          <a class="btn btn--plate" href="/id/">Beranda <Icon name="arrow" /></a>
          <a class="btn btn--line" href="/en/" lang="en">Home (English)</a>
        </div>
        <ul class="lost__links">
          {projects.slice(0, 4).map((p) => <li><a href={`/id/operations/${p.slug}/`}>{p.name.id}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost {
    min-height: 88svh;
    padding: clamp(9rem, 16vw, 12rem) 0 var(--s-9);
  }
  .lost__grid {
    display: grid;
    gap: var(--s-6);
  }
  .lost__grid > div {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .lost__depth {
    color: var(--on-laterite-2);
  }
  .lost__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: var(--s-4) 0 0;
  }
</style>
